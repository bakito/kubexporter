{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "go",
      "description": "Update toolbox tools in .toolbox.mk",
      "managerFilePatterns": [
        ".toolbox.mk"
      ],
      "matchStrings": [
        "# renovate: packageName=(?<packageName>.+?)\\s+.+?_VERSION \\?= (?<currentValue>.+?)\\s"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "description": "Update base image in .ko.yaml",
      "managerFilePatterns": [
        "/^\\.ko\\.yaml$/"
      ],
      "matchStrings": [
        "(?<replaceString>defaultBaseImage:\\s+(?<depName>[a-z0-9._/-]+):(?<currentValue>[^@\\s]+)@sha256:(?<currentDigest>[a-f0-9]+))"
      ]
    }
  ],
  "dependencyDashboard": true
}
